<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MermaidStudio.UI.Avalonia.Controls.NoSelectionInspectorView"
             x:CompileBindings="False"
             Background="#1B1B1B"
             HorizontalAlignment="Stretch">

	<Grid HorizontalAlignment="Stretch">
		<Border Background="#202020"
                BorderBrush="#313131"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                HorizontalAlignment="Stretch">
			<StackPanel Spacing="6"
                        HorizontalAlignment="Stretch">
				<TextBlock Text="No selection"
                           Foreground="White"
                           FontWeight="Bold"/>
				<TextBlock Text="Select a node, edge, state, or transition to edit its properties."
                           Foreground="#C8C8C8"
                           TextWrapping="Wrap"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
