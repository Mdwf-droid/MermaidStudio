<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MermaidStudio.UI.Avalonia.Controls.MermaidEditorPaneControl"
             x:CompileBindings="False"
             Background="#1B1B1B">

	<Border Background="#1B1B1B"
            BorderBrush="#333333"
            BorderThickness="1,0,0,0"
            Padding="10">

		<Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="8">

			<StackPanel Grid.Row="0"
                        Spacing="4">
				<TextBlock Text="Mermaid source"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"/>

				<TextBlock Text="Graphical view and Mermaid source stay synchronized. Source edits are applied automatically after a short pause if the text is valid."
                           Foreground="#BEBEBE"
                           TextWrapping="Wrap"/>
			</StackPanel>

			<Border Grid.Row="1"
                    x:Name="ErrorBorder"
                    Background="#3B1F1F"
                    BorderBrush="#7A3030"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    IsVisible="False">
				<TextBlock x:Name="ErrorTextBlock"
                           Foreground="#FFB5B5"
                           TextWrapping="Wrap"/>
			</Border>

			<Border Grid.Row="2"
                    Background="#202020"
                    BorderBrush="#313131"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
				<TextBox x:Name="MermaidEditorTextBox"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         MinHeight="260"
                         VerticalContentAlignment="Stretch"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         TextChanged="OnMermaidTextChanged"/>
			</Border>

		</Grid>
	</Border>
</UserControl>
