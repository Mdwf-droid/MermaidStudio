<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MermaidStudio.UI.Avalonia.Controls.FlowEdgeInspectorView"
             x:CompileBindings="False"
             Background="#1B1B1B"
             HorizontalAlignment="Stretch">

	<Grid HorizontalAlignment="Stretch">
		<StackPanel Spacing="10"
                    HorizontalAlignment="Stretch">

			<Expander Header="Selection"
                      IsExpanded="True"
                      HorizontalAlignment="Stretch">
				<Border Background="#202020"
                        BorderBrush="#313131"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch">
					<Grid ColumnDefinitions="120,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8"
                          HorizontalAlignment="Stretch">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Foreground="#D0D0D0"/>
						<TextBox x:Name="SelectionTypeTextBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True"/>

						<TextBlock Grid.Row="1" Grid.Column="0" Text="Id" Foreground="#D0D0D0"/>
						<TextBox x:Name="SelectionIdTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True"/>

						<TextBlock Grid.Row="2" Grid.Column="0" Text="Kind" Foreground="#D0D0D0"/>
						<TextBox x:Name="SelectionKindTextBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True"/>
					</Grid>
				</Border>
			</Expander>

			<Expander Header="Connection"
                      IsExpanded="True"
                      HorizontalAlignment="Stretch">
				<Border Background="#202020"
                        BorderBrush="#313131"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch">
					<Grid ColumnDefinitions="120,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8"
                          HorizontalAlignment="Stretch">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="Label" Foreground="#D0D0D0"/>
						<TextBox x:Name="EdgeLabelTextBox" Grid.Row="0" Grid.Column="1"/>

						<Button x:Name="ApplyEdgeLabelButton"
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                Content="Apply Edge Label"
                                Click="OnApplyEdgeLabelClicked"/>
					</Grid>
				</Border>
			</Expander>

			<Expander Header="Appearance"
                      IsExpanded="True"
                      HorizontalAlignment="Stretch">
				<Border Background="#202020"
                        BorderBrush="#313131"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch">
					<Grid ColumnDefinitions="120,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8"
                          HorizontalAlignment="Stretch">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="Edge Style" Foreground="#D0D0D0"/>
						<ComboBox x:Name="EdgeStyleComboBox" Grid.Row="0" Grid.Column="1" SelectedIndex="0">
							<ComboBoxItem Content="Default" />
							<ComboBoxItem Content="Dashed" />
							<ComboBoxItem Content="Thick" />
						</ComboBox>

						<TextBlock Grid.Row="1" Grid.Column="0" Text="Direction" Foreground="#D0D0D0"/>
						<ComboBox x:Name="EdgeDirectionComboBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0">
							<ComboBoxItem Content="Forward" />
							<ComboBoxItem Content="Reverse" />
						</ComboBox>

						<Button x:Name="ApplyEdgeStyleButton"
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                Content="Apply Edge Style"
                                Click="OnApplyEdgeStyleClicked"/>
					</Grid>
				</Border>
			</Expander>

		</StackPanel>
	</Grid>
</UserControl>
