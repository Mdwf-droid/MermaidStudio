<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MermaidStudio.UI.Avalonia.Controls"
        x:Class="MermaidStudio.UI.Avalonia.Views.MainWindow"
        x:CompileBindings="False"
        Width="1500"
        Height="850"
        Title="MermaidStudio"
        Background="#1E1E1E"
        KeyDown="OnWindowKeyDown">

	<Grid RowDefinitions="Auto,*"
          ColumnDefinitions="*,380">

		<!-- Barre haute -->
		<Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#252526"
                BorderBrush="#333333"
                BorderThickness="0,0,0,1"
                Padding="8">
			<DockPanel>
				<TextBlock Text="MermaidStudio — R3.B Viewport"
                           Foreground="White"
                           VerticalAlignment="Center"/>

				<StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="8">

					<TextBlock Text="Diagram:"
                               Foreground="White"
                               VerticalAlignment="Center"/>

					<ComboBox x:Name="DiagramKindComboBox"
                              Width="130"
                              SelectedIndex="0"
                              SelectionChanged="OnDiagramKindChanged">
						<ComboBoxItem Content="Flowchart" />
						<ComboBoxItem Content="State Diagram" />
					</ComboBox>

					<TextBlock Text="Direction:"
                               Foreground="White"
                               VerticalAlignment="Center"/>

					<ComboBox x:Name="FlowDirectionComboBox"
                              Width="90"
                              SelectedIndex="0"
                              SelectionChanged="OnFlowDirectionChanged">
						<ComboBoxItem Content="LR" />
						<ComboBoxItem Content="TB" />
						<ComboBoxItem Content="RL" />
						<ComboBoxItem Content="BT" />
					</ComboBox>

					<Button Content="Zoom -"
                            Click="OnZoomOutClicked"/>

					<Button Content="Zoom +"
                            Click="OnZoomInClicked"/>

					<Button Content="100%"
                            Click="OnResetZoomClicked"/>

					<Button Content="Fit"
                            Click="OnFitClicked"/>

					<Button Content="Center"
                            Click="OnCenterClicked"/>

					<Button x:Name="AddStartStateButton"
                            Content="Add Start State"
                            Click="OnAddStartStateClicked"
                            IsEnabled="False"/>

					<Button x:Name="AddEndStateButton"
                            Content="Add End State"
                            Click="OnAddEndStateClicked"
                            IsEnabled="False"/>

					<Button Content="Save JSON"
                            Click="OnSaveJsonClicked"/>

					<Button Content="Load JSON"
                            Click="OnLoadJsonClicked"/>

					<Button Content="Import Mermaid"
                            Click="OnImportMermaidClicked"/>

					<Button Content="Export Mermaid"
                            Click="OnExportMermaidClicked"/>
				</StackPanel>
			</DockPanel>
		</Border>

		<!-- Workspace -->
		<controls:DiagramWorkspaceControl x:Name="WorkspaceControl"
                                          Grid.Row="1"
                                          Grid.Column="0"/>

		<!-- Inspector -->
		<controls:InspectorPaneControl x:Name="InspectorPane"
                                       Grid.Row="1"
                                       Grid.Column="1"/>
	</Grid>
</Window>
